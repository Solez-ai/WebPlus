{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@webplus/runtime": [
                "../runtime/src"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}