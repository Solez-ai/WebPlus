// Web+ Worker Fibonacci Example
// Demonstrates concurrent background calculation using workers

int fib(int n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

void main() {
    dom::Element status = dom::get("#status");
    status.text("Calculating Fibonacci(40) in background...");
    
    worker w = worker::spawn([] {
        return fib(40);
    });
    
    int result = w.join();
    
    status.text("Result: " + result);
}
